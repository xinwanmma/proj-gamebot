# ===== 必填：智谱 API Key =====
# 在 https://open.bigmodel.cn/ 注册获取
ZHIPU_API_KEY=你的_API_KEY_填在这里

# ===== LLM 配置（可选） =====
# 智谱 API 地址（默认不动）
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 模型名（可选 glm-4-flash / glm-4-plus）
# ZHIPU_MODEL=glm-4-flash

# ===== Embedding 配置（可选） =====
# 中文向量模型
# EMBEDDING_MODEL=shibing624/text2vec-base-chinese
# 运行设备（cpu / cuda）
# EMBEDDING_DEVICE=cpu

# ===== Reranker 配置（可选） =====
# 是否启用 Cross-Encoder 精排（1=启用，0=禁用）
# RERANK_ENABLED=1
# Reranker 模型
# RERANKER_MODEL=BAAI/bge-reranker-base
# Reranker 设备（默认跟 embedding 一样）
# RERANKER_DEVICE=cpu
